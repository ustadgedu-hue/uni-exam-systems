# ═══════════════════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════════════
# Local:      copy this file to `.env` and fill in real values
# Production: set these in Vercel → Project → Settings → Environment Variables
#
# NEVER commit the real .env file. It is git-ignored on purpose.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Server ────────────────────────────────────────────────────────────────
# PORT is local-only. Vercel ignores it (serverless functions have no port).
PORT=5000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────
# Local MongoDB:
#   MONGO_URI=mongodb://127.0.0.1:27017/exam_system
# MongoDB Atlas (required for Vercel — see DEPLOYMENT.md step 1):
#   MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/exam_system?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/exam_system

# ─── Auth ──────────────────────────────────────────────────────────────────
# ⚠️  The app REFUSES TO START if JWT_SECRET is missing, shorter than 32
#     characters, or still set to the placeholder value below.
#     Generate a real one with:
#       node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_key_change_this_in_production
JWT_EXPIRE=7d

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# No trailing slash. Set this to your real Vercel frontend URL in production.
CORS_ORIGIN=http://localhost:3000

# ─── File storage (Cloudinary) ─────────────────────────────────────────────
# Get these from cloudinary.com → Dashboard → Product Environment Credentials.
# Without them the app still runs, but /api/resources returns 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
